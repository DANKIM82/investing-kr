# ============================================================
# investing-kr 환경 변수 설정
# ============================================================
# 이 파일을 `.env`로 복사한 후 실제 키 값을 입력하세요.
# `.env`는 .gitignore에 포함되어 GitHub에 올라가지 않습니다.

# ============================================================
# 한국 시장 (KR)
# ============================================================
# DART API 키 (필수, 한국 재무 데이터)
# 발급: https://opendart.fss.or.kr/uss/umt/login/loginPage.do
DART_API_KEY=YOUR_DART_API_KEY_HERE

# ============================================================
# 미국 시장 (US)
# ============================================================
# SEC EDGAR User-Agent (필수, SEC 정책에 따라)
# 형식: "회사명/이름 이메일@도메인.com"
SEC_USER_AGENT=Personal Research yourname@example.com

# FRED API 키 (옵션, 미국 10년 국채 등 거시 데이터)
# 발급: https://fred.stlouisfed.org/docs/api/api_key.html
# 미설정 시 default 4.5% 사용 (DCF 계산에 영향)
FRED_API_KEY=

# ============================================================
# 일본 시장 (JP)
# ============================================================
# J-Quants API (옵션, 일본 시장 상세 데이터)
# 발급: https://jpx-jquants.com/auth/signup/
# 미설정 시 yfinance만 사용 (제한적)
JQUANTS_REFRESH_TOKEN=

# ============================================================
# 기타 (옵션)
# ============================================================
# Alpha Vantage (대체 미국 데이터 소스)
ALPHAVANTAGE_KEY=

# Financial Modeling Prep (대체)
FMP_API_KEY=

# ============================================================
# 회사 표시 설정
# ============================================================
# 보고서 푸터에 표시될 이름. 기본값: "Personal Research"
# 절대 실제 투자기관 이름 사칭 금지 (KB증권, 미래에셋, Goldman 등)
FIRM_NAME=Personal Research
